<mujocoinclude>
  <!-- Table: top at z = 0.80 + 0.02 = 0.82 -->
  <body name="table" pos="0.65 0 0">
    <geom name="table_top" type="box" size="0.25 0.4 0.02" pos="0 0 0.80"
          rgba="0.72 0.55 0.36 1" friction="1 0.005 0.001"/>

    <geom name="table_leg_fl" type="box" size="0.02 0.02 0.40" pos=" 0.23  0.38 0.40" rgba="0.4 0.3 0.2 1"/>
    <geom name="table_leg_fr" type="box" size="0.02 0.02 0.40" pos=" 0.23 -0.38 0.40" rgba="0.4 0.3 0.2 1"/>
    <geom name="table_leg_bl" type="box" size="0.02 0.02 0.40" pos="-0.23  0.38 0.40" rgba="0.4 0.3 0.2 1"/>
    <geom name="table_leg_br" type="box" size="0.02 0.02 0.40" pos="-0.23 -0.38 0.40" rgba="0.4 0.3 0.2 1"/>
  </body>

  <!-- Brown open-top container -->
  <!-- body center at z = table_top(0.82) + half_height(0.04) = 0.86 -->
  <!-- Moved from x=0.70 to x=0.60 so both arms can reach the container center comfortably. -->
  <body name="container" pos="0.60 0.0 0.86">
    <geom name="cont_base"    type="box" size="0.11 0.11 0.005"  pos="0 0 -0.035"
          rgba="0.55 0.35 0.20 1" friction="1 0.005 0.001"/>
    <geom name="cont_wall_px" type="box" size="0.005 0.11 0.035" pos=" 0.105 0      0.005"
          rgba="0.55 0.35 0.20 1"/>
    <geom name="cont_wall_nx" type="box" size="0.005 0.11 0.035" pos="-0.105 0      0.005"
          rgba="0.55 0.35 0.20 1"/>
    <geom name="cont_wall_py" type="box" size="0.11 0.005 0.035" pos=" 0      0.105 0.005"
          rgba="0.55 0.35 0.20 1"/>
    <geom name="cont_wall_ny" type="box" size="0.11 0.005 0.035" pos=" 0     -0.105 0.005"
          rgba="0.55 0.35 0.20 1"/>
  </body>

  <!-- Red block: between robot and container, close to robot -->
  <body name="red_block" pos="0.55 -0.30 0.87">
    <freejoint name="red_block_free"/>
    <inertial pos="0 0 0" mass="0.05" diaginertia="2.1e-5 2.1e-5 2.1e-5"/>
    <geom name="red_block_geom" type="box" size="0.025 0.025 0.025"
          rgba="0.9 0.1 0.1 1" friction="1.0 0.01 0.001" condim="4"/>
  </body>

  <!-- Green block: robot's left side (+Y), front -->
  <body name="green_block" pos="0.55 0.30 0.87">
    <freejoint name="green_block_free"/>
    <inertial pos="0 0 0" mass="0.05" diaginertia="2.1e-5 2.1e-5 2.1e-5"/>
    <geom name="green_block_geom" type="box" size="0.025 0.025 0.025"
          rgba="0.1 0.8 0.2 1" friction="1.0 0.01 0.001" condim="4"/>
  </body>

  <!-- Blue block: robot's left side (+Y), back.
       x was 0.65, outside LEFT_ARM_REACH x=[0.45,0.60] (scene_utils.py) used during
       data collection, i.e. out of the training distribution. Moved inside. -->
  <body name="blue_block" pos="0.45 0.13 0.87">
    <freejoint name="blue_block_free"/>
    <inertial pos="0 0 0" mass="0.05" diaginertia="2.1e-5 2.1e-5 2.1e-5"/>
    <geom name="blue_block_geom" type="box" size="0.025 0.025 0.025"
          rgba="0.1 0.2 0.9 1" friction="1.0 0.01 0.001" condim="4"/>
  </body>
</mujocoinclude>
